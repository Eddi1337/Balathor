{
  "name": "balathor",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative server and sprite-canvas client prototype for Balathor.",
  "scripts": {
    "dev": "node tools/dev.js",
    "server": "node server/src/index.js",
    "client": "node client/dev-server.js",
    "smoke": "node tests/smoke.mjs",
    "test:mobile": "node --test tests/mobile-touch.mjs",
    "stress": "node tools/stress.mjs",
    "generate:sci-fi-station": "node tools/generateSciFiStation.mjs",
    "stress:remote": "node tools/stress.mjs --url wss://balathor.edmundmurphy.com/ws",
    "server:docker:build": "docker build -t balathor-server ./server",
    "server:docker:run": "docker run --rm --name balathor-server -p 8080:8080 balathor-server",
    "client:docker:build": "docker build -t balathor-client ./client",
    "client:docker:run": "docker run --rm --name balathor-client -p 3000:3000 -e GAME_SERVER_URL=ws://localhost:8080/ws balathor-client",
    "client:desktop:install": "npm install --prefix client/desktop",
    "client:desktop:dev": "npm run dev --prefix client/desktop",
    "client:desktop:build:win-dir": "npm run build:win:dir --prefix client/desktop",
    "client:desktop:build:win": "npm run build:win --prefix client/desktop"
  },
  "engines": {
    "node": ">=22"
  }
}
